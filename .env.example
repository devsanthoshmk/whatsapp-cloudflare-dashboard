# Cloudflare Worker / Wrangler Secrets & Environment Variables
# Copy this to .dev.vars for local development with `wrangler dev`

# YCloud WhatsApp API key
YCLOUD_API_KEY=your_ycloud_api_key_here

# WhatsApp Webhook Verification Token (configured in Meta App Dashboard)
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# Dashboard Authentication Credentials
AUTH_PASSWORD=your_secure_dashboard_password
AUTH_SECRET=your_32_character_random_hex_auth_secret

# WhatsApp Business Configuration
PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WABA_ID=your_whatsapp_business_account_id

# Optional R2 Public URL (if public bucket access enabled)
# R2_PUBLIC_URL=https://media.yourdomain.com

# Node.js Webhook Server Configuration (Legacy / Local bridge)
PORT=3000
GRAPH_API_TOKEN=your_meta_graph_api_token_here
GRAPH_API_VERSION=v21.0
